{
  "name": "personal-context-poc",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @personal-context/web dev",
    "build": "pnpm --filter @personal-context/web build",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run --exclude tests/database.integration.test.ts",
    "test:integration": "vitest run tests/database.integration.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @personal-context/db generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:studio": "pnpm --filter @personal-context/db studio",
    "ingest": "node --import tsx scripts/ingest.ts",
    "inspect": "node --import tsx scripts/inspect.ts",
    "demo:fixtures": "node --import tsx scripts/create-demo-fixtures.ts"
  },
  "dependencies": {
    "@personal-context/core": "workspace:*",
    "@personal-context/db": "workspace:*",
    "@personal-context/processors": "workspace:*",
    "@personal-context/sources": "workspace:*",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "drizzle-orm": "0.45.3"
  }
}
